# Gemini is used for story planning, critique, and revision.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Replicate is used only for image generation.
REPLICATE_API_TOKEN=your_replicate_api_token_here
REPLICATE_IMAGE_MODEL=google/imagen-4
REPLICATE_IMAGE_SIZE=1K
REPLICATE_IMAGE_ASPECT_RATIO=3:4
REPLICATE_IMAGE_OUTPUT_FORMAT=jpg
REPLICATE_SAFETY_FILTER_LEVEL=block_medium_and_above

# Set to true to run a no-API demo with clearly labelled placeholders.
STORYBOOK_DEMO_MODE=false

